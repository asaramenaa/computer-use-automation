# Copy to .env (gitignored). Never commit real keys.

# --- LLM used ONLY by `cuc discover` (replay never loads a model) ---
LLM_PROVIDER=groq                   # groq | gemini | anthropic
LLM_MODEL=openai/gpt-oss-120b       # gemini: gemini-2.5-flash   anthropic: claude-opus-5
GROQ_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
LLM_MAX_RETRIES=4                   # retries on HTTP 429 with exponential backoff, then give up
LLM_RETRY_BASE_SECONDS=10
LLM_REQUEST_TIMEOUT_S=120             # a hung model request fails fast and is retried under the same cap
CUC_MAX_STEPS=20                    # hard cap on model turns per discovery run
LLM_REASONING_EFFORT=low            # groq gpt-oss only: keeps per-turn output small on a free tier

# --- Target app credentials, referenced by name from artifacts (never stored in them) ---
TARGET_APP_USER=teller1
TARGET_APP_PASSWORD=Passw0rd!
TARGET_APP_PORT=5055
TARGET_APP_SLOW_SECONDS=4           # delay used by the injected "slow" fault

# --- Handoff ---
CUC_HANDOFF_TIMEOUT_S=900           # how long automation waits for `cuc resume` before abandoning
